#include <msp430.h>
#include <stdio.h>
#include "LiquidCrystal_I2C.h"

char Buffer1[8] = {0};
int Buffervalue[4] = {0};
unsigned int IncrBuffervalue = 0;

unsigned char messagesent = 0;
unsigned int NewDutyCycle = 0;

int interruptflag = 0;
char value[] = {0,0,0,0,0,0};
char DutyCycleTry2[] = {0,0,0,0};

char DutyCycleTry2_3;
char DutyCycleTry2_2;
char DutyCycleTry2_1;

volatile unsigned int char_count = 0;
volatile unsigned int timeout_counter = 0;

int main(void)
{
    WDTCTL = WDTPW | WDTHOLD;
    UCA0CTLW0 |= UCSWRST;
    UCA0CTLW0 |= UCSSEL__SMCLK;               // Clock source SMCLK
    UCA0BR0 = 6;                              // Baud Rate 9600
    UCA0MCTLW = 0x2081;

    P1SEL1 &= ~BIT6;                          // configure to rx pin
    P1SEL0 |= BIT6;                           // Rx is in pin 1.6
    P1SEL1 &= ~BIT7;                          // configure to tx pin
    P1SEL0 |= BIT7;                           // Tx is in pin 1.7

    PM5CTL0 &= ~LOCKLPM5;

    UCA0CTLW0 &= ~UCSWRST;                    // Initialize UART
    UCA0IE |= UCRXIE;                         // Enable USCI_A1 RX interrupt
    __enable_interrupt();

    // Configure motor PWM output on P6.1
    P6DIR |= BIT1;                            // Set pin 6.1 as output
    P6OUT &= ~BIT1;                           // Start with motor off

    TB0CTL = TBSSEL__ACLK | MC__UP | TBCLR;

    TB0CCR0 = 1000;                           // PWM period
    TB0CCR1 = 0;                              // Initial duty cycle

    TB0CCTL0 |= CCIE;                         // Enable CCR0 interrupt
    TB0CCTL1 |= CCIE;

    TB0CCTL0 &= ~CCIFG;                       // Clear CCR0 flag
    TB0CCTL1 &= ~CCIFG;

    // Initialize LCD
    I2C_Init(0x27);
    LCD_Setup();
    LCD_SetCursor(0, 0);
    LCD_ClearDisplay();
    LCD_Write("Fan Speed: ");
    LCD_WriteNum(0);

    // Timeout timer setup
    TB1CTL = TBSSEL__ACLK | MC__UP | TBCLR;
    TB1CCR0 = 16384;
    TB1CCTL0 |= CCIE;
    TB1CCTL0 &= ~CCIFG;

    while(1)
    {
        if(messagesent == 1)
        {
            LCD_ClearDisplay();
            LCD_Write("Fan Speed: ");
            LCD_WriteNum(DutyCycleTry2_3 - '0');
            LCD_WriteNum(DutyCycleTry2_2 - '0');
            LCD_WriteNum(DutyCycleTry2_1 - '0');

            NewDutyCycle = ((100*(DutyCycleTry2_3 - '0'))+(10*(DutyCycleTry2_2 - '0'))+(DutyCycleTry2_1 - '0'));
            if(NewDutyCycle >= 100)
                NewDutyCycle = 99;

            TB0CCR1 = NewDutyCycle * 10;

            IncrBuffervalue = 0;
            messagesent = 0;
        }
    }

    return 0;
}

/*****************************
*      vector interrupts     *
*****************************/

#pragma vector=TIMER0_B0_VECTOR
__interrupt void ISR_TB0_CCR0(void)
{
    if(TB0CCR1 != 0)
    {
        P6OUT |= BIT1;                        // turn on motor
    }
    TB0CCTL0 &= ~CCIFG;
}

#pragma vector=TIMER0_B1_VECTOR
__interrupt void ISR_TB0_CCR1(void)
{
    P6OUT &= ~BIT1;                           // turn off motor
    TB0CCTL1 &= ~CCIFG;
}

#pragma vector=TIMER1_B0_VECTOR
__interrupt void ISR_TB1_CCR0(void)
{
    timeout_counter++;

    if(char_count > 0 && timeout_counter > 1)
    {
        char last_char = value[0];
        int speed;

        if(last_char >= '0' && last_char <= '9')
        {
            speed = (last_char - '0') * 10;
        }
        else if(last_char == 'a' || last_char == 'A')
        {
            speed = 100;
        }
        else
        {
            speed = 0;
        }

        DutyCycleTry2_3 = (speed / 100) + '0';
        DutyCycleTry2_2 = ((speed / 10) % 10) + '0';
        DutyCycleTry2_1 = (speed % 10) + '0';

        messagesent = 1;
        char_count = 0;
        timeout_counter = 0;
    }

    TB1CCTL0 &= ~CCIFG;
}

#pragma vector=USCI_A0_VECTOR
__interrupt void USCI_A0_ISR(void)
{
    char received_char = UCA0RXBUF;
    char_count++;
    timeout_counter = 0;

    int speed;

    if(received_char >= '0' && received_char <= '9')
    {
        speed = (received_char - '0') * 10;
    }
    else if(received_char == 'a' || received_char == 'A')
    {
        speed = 100;
    }
    else
    {
        speed = 0;
    }

    DutyCycleTry2_3 = (speed / 100) + '0';
    DutyCycleTry2_2 = ((speed / 10) % 10) + '0';
    DutyCycleTry2_1 = (speed % 10) + '0';

    messagesent = 1;

    value[5] = value[4];
    value[4] = value[3];
    value[3] = value[2];
    value[2] = value[1];
    value[1] = value[0];
    value[0] = received_char;
}


